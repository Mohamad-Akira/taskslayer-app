rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'profile', 'theme', 'language']) &&
             data.userId == request.auth.uid &&
             data.theme is string &&
             data.language is string;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidId(userId) &&
                    isValidUserProfile(incoming());
      allow update: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidUserProfile(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'status', 'priority', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['todo', 'in_progress', 'done'] &&
             data.priority in ['low', 'medium', 'high', 'urgent'];
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidId(taskId) &&
                    isValidTask(incoming()) &&
                    exists(/databases/$(database)/documents/users/$(userId));
      allow update: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidTask(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
